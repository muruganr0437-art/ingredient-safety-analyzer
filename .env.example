# Copy to .env and edit. NEVER commit .env.
# --- Storage ---
# DATA_DIR=./data
# DB_PATH=./data/analyzer.db
# --- Uploads ---
MAX_UPLOAD_MB=8
# --- OCR ---
# Windows example (only needed if tesseract is not on PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
# --- Admin page (leave empty to DISABLE the admin page) ---
ADMIN_PASSWORD=
# --- Optional AI explanations (OFF by default; core app works without) ---
AI_ENABLED=false
# Any OpenAI-compatible chat-completions endpoint:
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# --- Emergency resources (country -> verified contacts; see data/emergency_resources.example.json) ---
EMERGENCY_RESOURCES_FILE=./data/emergency_resources.json
